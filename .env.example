# Environment variables for Iðunn
# Copy this file to .env and fill in your values

# App
APP_NAME=Iðunn
APP_VERSION=0.1.0
DEBUG=false

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=idunn

# Redis (for Arq jobs)
REDIS_URL=redis://localhost:6379

# Object store (MinIO/R2)
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_BUCKET=idunn

# LLM (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-3-5-haiku-latest
ANTHROPIC_MODEL_RANK=claude-sonnet-4-5

# Embeddings
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large

# Reranker
COHERE_API_KEY=
RERANKER_MODEL=rerank-3

# OCR
PADDLE_OCR_ENABLED=true

# CORS
CORS_ORIGINS=["http://localhost:3000"]
