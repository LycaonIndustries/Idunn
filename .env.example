# Environment variables for Iðunn
# Copy this file to .env and fill in your values

# App
APP_NAME=Iðunn
APP_VERSION=0.1.0
DEBUG=false

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=idunn

# Redis (for Arq jobs)
REDIS_URL=redis://localhost:6379

# Object store (MinIO/R2)
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_BUCKET=idunn

# LLM (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_RANK=claude-sonnet-4-5

# LLM (BYOK Providers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Embeddings
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024
INGREDIENT_VECTOR_INDEX=ingredient_embeddings
INGREDIENT_MATCH_THRESHOLD=0.9
INGREDIENT_MATCH_MARGIN=0.05

# Recipe source limits
SOURCE_TIMEOUT_SECONDS=30
SOURCE_MAX_BYTES=2000000
SOURCE_MAX_TEXT_CHARS=60000
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
VIDEO_MAX_SECONDS=1800
VIDEO_MAX_BYTES=100000000
VIDEO_TIMEOUT_SECONDS=900
WHISPER_MODEL=large-v3
# Use a cached model. Set false only when you want Whisper to download its model.
WHISPER_LOCAL_FILES_ONLY=true

# Reranker
COHERE_API_KEY=
RERANKER_MODEL=rerank-3

# OCR
PADDLE_OCR_ENABLED=true

# CORS
CORS_ORIGINS=["http://localhost:3000"]
